{
  "name": "back",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run check:sites && npm run sites:css && tsc",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "auth:generate": "auth generate --config src/auth.ts --output src/db/auth-schema.ts --yes",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:clinic": "tsx src/db/seed-clinic.ts",
    "db:constraints": "tsx src/db/apply-constraints.ts",
    "db:backfill-patients": "tsx src/db/backfill-patients.ts",
    "db:encrypt-clinical": "tsx src/db/encrypt-clinical.ts",
    "db:seed-exercises": "tsx src/db/seed-exercises.ts",
    "db:seed-plans": "tsx src/db/seed-plans.ts",
    "email:test": "tsx src/scripts/send-test-email.ts",
    "check:sites": "sh scripts/check-sites.sh",
    "sites:dev": "npm run sites:css && (npm run sites:css -- --watch=always & tsx watch --env-file=.env.sites src/sites/index.ts)",
    "sites:start": "node dist/sites/index.js",
    "sites:demo": "tsx src/db/seed-site-demo.ts",
    "sites:css": "tailwindcss -i src/sites/tailwind.css -o sites-assets/generated/sites.css --minify"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "better-auth": "^1.7.20",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "auth": "^1.7.20",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module"
}
