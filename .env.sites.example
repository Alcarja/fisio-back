# The sites service's own variables (WEBS.md 3.8). Locally: copy to .env.sites
# and run `npm run sites:dev`. NEVER put DATABASE_URL, DATA_ENCRYPTION_KEY or
# BETTER_AUTH_SECRET here: the service refuses to start with them.
SITES_PORT=3001
SITES_HOST=127.0.0.1
# Locally "localhost": open http://<subdomain>.localhost:3001
SITES_BASE_DOMAIN=localhost
# The read-only user kineflow_sites (WEBS.md 3.2), pooled connection string
SITES_DATABASE_URL=postgresql://kineflow_sites:<password>@<host>-pooler.<region>.aws.neon.tech/neondb?sslmode=require
# Same value as in the API's .env (32+ characters)
SITES_PREVIEW_SECRET=
# The app (booking frame, links). Locally the Vite dev server
APP_URL=http://localhost:5173
