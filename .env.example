DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=verify-full&channel_binding=require
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
# Encrypts the clinical texts in the database (src/lib/encryption.ts).
# Generate with: openssl rand -base64 32
# KEEP A COPY somewhere safe, away from the server and the database: without
# this exact key the clinical histories can't be read ever again
DATA_ENCRYPTION_KEY=
BETTER_AUTH_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SUPERADMIN_NAME=Your Name
SUPERADMIN_EMAIL=you@example.com
SUPERADMIN_PASSWORD=at-least-10-characters

# Appointment reminders (src/lib/reminders.ts). Set to true ONLY on the
# production server: any machine with it on emails real patients
SEND_REMINDERS=false

# Email (Brevo). Without BREVO_API_KEY, emails are printed to the console
BREVO_API_KEY=
# Sender address on your domain, authenticated in Brevo
EMAIL_FROM_ADDRESS=notificaciones@yourdomain.com
# Display name for platform emails (clinic emails use the clinic's name)
EMAIL_FROM_NAME=Kineflow
# Reply-To for platform emails (password resets, owner invitations)
EMAIL_SUPPORT_ADDRESS=hola@yourdomain.com
# Where the website's contact form requests are sent (defaults to EMAIL_SUPPORT_ADDRESS)
CONTACT_NOTIFY_EMAIL=

# Own domains (Mi web → Dirección, WEBS.md Phase 4). The server's public IPs:
# the clinic's A record must point here. Without SERVER_IPV4 the feature is off
SERVER_IPV4=
SERVER_IPV6=
# Check the clinics' DNS every 10 minutes (only on the server)
CHECK_DOMAINS=false
