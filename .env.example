DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=verify-full&channel_binding=require
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SUPERADMIN_NAME=Your Name
SUPERADMIN_EMAIL=you@example.com
SUPERADMIN_PASSWORD=at-least-10-characters

# Email (Brevo). Without BREVO_API_KEY, emails are printed to the console
BREVO_API_KEY=
# Sender address on your domain, authenticated in Brevo
EMAIL_FROM_ADDRESS=notificaciones@yourdomain.com
# Display name for platform emails (clinic emails use the clinic's name)
EMAIL_FROM_NAME=Kineflow
# Reply-To for platform emails (password resets, owner invitations)
EMAIL_SUPPORT_ADDRESS=hola@yourdomain.com
# Where the website's contact form requests are sent (defaults to EMAIL_SUPPORT_ADDRESS)
CONTACT_NOTIFY_EMAIL=
